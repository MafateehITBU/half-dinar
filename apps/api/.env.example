# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DATABASE_URL=postgresql://half_dinar:half_dinar_dev@localhost:5435/half_dinar?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=half_dinar_meili_dev_key

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Seed super admin (development only)
SEED_SUPER_ADMIN_EMAIL=admin@abou-al-nas.local
SEED_SUPER_ADMIN_PASSWORD=Admin123!ChangeMe

# Email (SMTP) — configure later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@abou-al-nas.local

# Cloudinary — required for admin product image upload (multer → Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe — Dashboard → Developers → API keys (test mode). Visa/Mastercard use these, not separate Visa credentials.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Storefront (same pk_test): apps/storefront/.env → VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Charge currency: usd works on most test accounts; use jod only if enabled in Stripe Dashboard → Settings → Payments
STRIPE_CHARGE_CURRENCY=usd
STRIPE_JOD_TO_USD=1.41

# Analytics (optional — set via admin Settings or here)
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# META_PIXEL_ID=123456789
