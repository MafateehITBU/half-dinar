# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DATABASE_URL=postgresql://half_dinar:half_dinar_dev@localhost:5435/half_dinar?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=half_dinar_meili_dev_key

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed super admin (development only)
SEED_SUPER_ADMIN_EMAIL=admin@abou-al-nas.local
SEED_SUPER_ADMIN_PASSWORD=Admin123!ChangeMe

# Email (SMTP) — configure later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@abou-al-nas.local

# Cloudinary — required for admin product image upload (multer → Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MEPS / PayTabs Jordan — Merchant Dashboard → Developers → API Keys → Key management
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CLIENT_KEY=
PAYTABS_REGION=JOR
PAYTABS_BASE_URL=https://secure-jordan.paytabs.com
# Optional: public HTTPS tunnel for local callbacks (e.g. https://xxxx.ngrok.io/api/v1/webhooks/paytabs)
# PAYTABS_CALLBACK_URL=

# Legacy Stripe (unused — checkout uses MEPS)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Analytics (optional — set via admin Settings or here)
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# META_PIXEL_ID=123456789
